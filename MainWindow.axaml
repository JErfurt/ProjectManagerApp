<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ProjectManagerApp"
        mc:Ignorable="d"
        x:Class="ProjectManagerApp.MainWindow"
        x:DataType="vm:MainWindow"
        Width="1300" Height="600" Title="Project Manager">
    <Window.Styles>
        <Style Selector="Button.icon Path">
            <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>
    <DockPanel>
        <!-- Панель инструментов -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="10,10,10,0">
            <!-- Кнопка Открыть папку -->
            <Button Classes="icon" Click="OpenConfigFolder" Width="32" Height="32" ToolTip.Tip="Открыть папку с конфигом" Margin="5">
                <Path Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z"/>
            </Button>

            <!-- Кнопка Добавить строку -->
            <Button Classes="icon" Click="AddProject" Width="32" Height="32" ToolTip.Tip="Добавить строку" Margin="5">
                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
            </Button>
            
            <!-- Разделитель -->
            <Border Width="1" Background="Gray" Margin="10,5"/>
            
            <!-- Фильтр по языку -->
            <TextBlock Text="Фильтр по языку:" VerticalAlignment="Center" Margin="5,0"/>
            <ComboBox ItemsSource="{x:Static vm:MainWindow.FilterLanguages}" 
                      SelectedItem="{Binding SelectedLanguageFilter}" 
                      Width="150" 
                      Margin="5"
                      VerticalAlignment="Center"/>
            
            <!-- Разделитель -->
            <Border Width="1" Background="Gray" Margin="10,5"/>
            
            <!-- Поиск -->
            <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="5,0,0,0"
                  Fill="{Binding $parent[Window].Foreground}"
                  Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>
            <TextBox Text="{Binding SearchQuery, Mode=TwoWay}" 
                     Watermark="Поиск по названию и описанию..." 
                     Width="250" 
                     Margin="5"
                     VerticalAlignment="Center"/>
        </StackPanel>


        <DataGrid Margin="20" ItemsSource="{Binding Projects}"
          AutoGenerateColumns="False" IsReadOnly="False"
          GridLinesVisibility="All" HeadersVisibility="All"
          BorderThickness="1" BorderBrush="Gray"
          SelectedItem="{Binding SelectedProject, Mode=TwoWay}" x:Name="Root">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Удалить строку" Command="{Binding RemoveProjectCommand}" CommandParameter="{Binding SelectedItem, ElementName=Root}" />
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Действия">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Classes="icon"
                                        Width="32" Height="32"
                                        ToolTip.Tip="Открыть папку с проектом"
                                        Command="{x:Static vm:MainWindow.OpenFolderCommand}"
                                        CommandParameter="{Binding}"
                                        Margin="5">
                                    <Path Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z"/>
                                </Button>
                                <Button Classes="icon"
                                        Width="32" Height="32"
                                        ToolTip.Tip="Открыть проект в редакторе"
                                        Command="{x:Static vm:MainWindow.OpenInEditorCommand}"
                                        CommandParameter="{Binding}"
                                        Margin="5">
                                    <Path Data="M14.6,16.6L19.2,12L14.6,7.4L16,6L22,12L16,18L14.6,16.6M9.4,16.6L4.8,12L9.4,7.4L8,6L2,12L8,18L9.4,16.6Z"/>
                                </Button>
                                <Button Classes="icon"
                                        Width="32" Height="32"
                                        ToolTip.Tip="Запустить проект"
                                        Command="{x:Static vm:MainWindow.RunBatchCommand}"
                                        CommandParameter="{Binding}"
                                        Margin="5">
                                    <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Header="Название проекта" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" />
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" />
                <DataGridTemplateColumn Header="Тип">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Language}" VerticalAlignment="Center" Margin="5,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{x:Static vm:MainWindow.AvailableLanguages}" 
                                      SelectedItem="{Binding Language}" 
                                      HorizontalAlignment="Stretch"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Последнее взаимодействие" Binding="{Binding LastInteractionDisplay}" IsReadOnly="True" />
                <DataGridTextColumn Header="Директория" Binding="{Binding FolderPath}" />
                
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
